# Copy to .env.local. Never commit populated environment files.
# npm run dev explicitly selects local demo. No external calls are made in demo.
APP_MODE=demo
APP_ORIGIN=http://127.0.0.1:3107
LOCAL_DATA_DIR=.local/demo

# For npm run dev:sandbox: configure all fields below, apply the migration,
# provision controlled Auth users + trusted memberships, and create a private
# receipts bucket. Supabase keys, database credentials, AI and PayPal stay server-side.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
WORKER_SECRET=
