{
  "name": "carry-demo-video",
  "version": "1.0.0",
  "description": "Carry reimbursement workflow demonstration for the PayPal AI Hackathon",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@mediabunny/server": "1.64.0",
    "@remotion/captions": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "@remotion/whisper-webgpu": "4.0.541",
    "mediabunny": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.541",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --port=3210",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "captions": "node scripts/prepare-captions.mjs",
    "render": "remotion render CarryDemo out/carry-demo.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "verify": "node scripts/verify-assets.mjs"
  },
  "allowScripts": {
    "esbuild": false
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "sharp": "0.35.5"
